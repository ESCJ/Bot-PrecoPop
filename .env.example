# Telegram Bot (obtenha em https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=seu_token_aqui
TELEGRAM_WEBHOOK_SECRET=um_segredo_seguro

# Admin e Grupos (descubra com @userinfobot ou @getidsbot)
ADMIN_CHAT_ID=123456789
SHIPPING_GROUP_CHAT_ID=-1001234567890

# Mercado Pago (https://www.mercadopago.com.br/developers)
MERCADO_PAGO_ACCESS_TOKEN=TEST-... ou APP_USR-...
MERCADO_PAGO_WEBHOOK_SECRET=segredo_webhook_mp

# Servidor
# No Railway, a porta é definida automaticamente pela variável PORT.
# WEBHOOK_URL deve ser a URL HTTPS do Railway + /webhook/telegram
# PUBLIC_URL deve ser a URL HTTPS base do Railway
PORT=3000
WEBHOOK_URL=https://seu-dominio.com/webhook/telegram
PUBLIC_URL=https://seu-dominio.com

# Banco de dados
# No Railway, use um volume persistente ou um caminho absoluto.
# Exemplo com volume montado em /data: DATABASE_URL=/data/bot.db
DATABASE_URL=./data/bot.db

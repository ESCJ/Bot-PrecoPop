# ==========================================================================
# Grupo Vip - Loja Preço Pop | Configuração de ambiente
# Copie para `.env` e preencha. O app falha na inicialização listando
# exatamente quais variáveis estão faltando ou inválidas.
# ==========================================================================

# --- Ambiente ------------------------------------------------------------
# development | test | production
NODE_ENV=development
# silent | fatal | error | warn | info | debug | trace
LOG_LEVEL=info
STORE_NAME=Grupo Vip - Loja Preço Pop

# --- Telegram ------------------------------------------------------------
# Token obtido em https://t.me/BotFather
TELEGRAM_BOT_TOKEN=

# Segredo do webhook do Telegram: 8 a 256 caracteres, apenas A-Z a-z 0-9 _ -
# Gere um valor forte, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
TELEGRAM_WEBHOOK_SECRET=

# --- Administração -------------------------------------------------------
# Lista de chat IDs de administradores, separados por vírgula.
# Descubra o seu com @userinfobot. O primeiro da lista recebe os alertas.
ADMIN_CHAT_IDS=123456789

# Grupo/canal que recebe os avisos de pedidos pagos para separação e envio.
SHIPPING_GROUP_CHAT_ID=-1001234567890

# --- Mercado Pago --------------------------------------------------------
# Access Token (NÃO é a Public Key): https://www.mercadopago.com.br/developers
MERCADO_PAGO_ACCESS_TOKEN=

# Segredo gerado pelo Mercado Pago ao cadastrar a URL de notificação.
# A URL a cadastrar é: {PUBLIC_URL}/webhooks/mercadopago
MERCADO_PAGO_WEBHOOK_SECRET=

# --- Servidor HTTP -------------------------------------------------------
# No Railway a porta é injetada automaticamente pela variável PORT.
PORT=3000

# URL HTTPS pública base (sem barra no final). Usada no retorno do checkout
# e na URL de notificação enviada ao Mercado Pago.
PUBLIC_URL=http://localhost:3000

# URL HTTPS base para registrar o webhook do Telegram.
# Deixe VAZIO em desenvolvimento para o bot usar long polling.
WEBHOOK_URL=

# --- Banco de dados (PostgreSQL obrigatório) ----------------------------
# Local:   postgres://postgres:postgres@localhost:5432/precopop
# Railway: use a variável de referência ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://postgres:postgres@localhost:5432/precopop

# Tamanho máximo do pool de conexões.
DATABASE_POOL_MAX=10

# SSL da conexão. Use "true" no Railway/produção e "false" em Postgres local.
DATABASE_SSL=false

# --- Regras de venda -----------------------------------------------------
# Minutos que o Pix fica válido e o estoque permanece reservado.
PIX_TTL_MINUTES=30

# Valor mínimo em CENTAVOS para frete grátis. 0 desativa a regra.
# Exemplo: 20000 = frete grátis acima de R$ 200,00
FREE_SHIPPING_THRESHOLD_CENTS=0

# Frete padrão em CENTAVOS quando a UF não tem tarifa cadastrada.
DEFAULT_SHIPPING_CENTS=2500

# --- Integrações ---------------------------------------------------------
# Timeout do ViaCEP. Se estourar, o cadastro cai para preenchimento manual.
VIACEP_TIMEOUT_MS=4000

# --- Sessão --------------------------------------------------------------
# Dias que uma sessão inativa é mantida no banco antes da limpeza.
SESSION_TTL_DAYS=30

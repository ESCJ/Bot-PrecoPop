# Telegram Bot (obtenha em https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=seu_token_aqui
# Use apenas letras e números. Não use @, . ou caracteres especiais.
TELEGRAM_WEBHOOK_SECRET=seguro123

# Admin e Grupos (descubra com @userinfobot ou @getidsbot)
ADMIN_CHAT_ID=123456789
SHIPPING_GROUP_CHAT_ID=-1001234567890

# Mercado Pago (https://www.mercadopago.com.br/developers)
# Use o Access Token, não a Public Key
MERCADO_PAGO_ACCESS_TOKEN=TEST-... ou APP_USR-...
# Segredo gerado automaticamente pelo Mercado Pago ao configurar o webhook
MERCADO_PAGO_WEBHOOK_SECRET=segredo_gerado_pelo_mp

# Servidor
# No Railway, a porta é definida automaticamente pela variável PORT.
# WEBHOOK_URL deve ser a URL HTTPS base do Railway (sem /webhook/telegram)
# PUBLIC_URL deve ser a URL HTTPS base do Railway
# Deixe WEBHOOK_URL vazio para usar polling (modo desenvolvimento)
PORT=3000
WEBHOOK_URL=
PUBLIC_URL=http://localhost:3000

# Banco de dados
# Para desenvolvimento local: ./data/bot.db
# Para Railway com PostgreSQL: postgres://user:pass@host:port/dbname
DATABASE_URL=./data/bot.db
